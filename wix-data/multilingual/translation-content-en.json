      "parentEntityId": "sbj2r",
      "publishStatus": "UNPUBLISHED",
      "updatedDate": "2026-11-05T19:51:27.466Z",
      "fields": {
        "compFeatures-wRichText-data-styledText-text": "<ul class=\"font_8\" style=\"font-size:18px\"> \n <li> <p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Brand-New Navaris Vessel: Fully rigged, offshore-tested, and turnkey charter-ready.</span></p> </li> \n <li> <p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Complete Protection &amp; Care: Full commercial marine insurance coverage, Croatian registration and all scheduled engine servicing.&nbsp;</span></p> </li> \n <li> <p class=\"font_8\" style=\"font-size:18px\"><span style=\"font-size:18px\">Turnkey Booking Infrastructure: Dedicated online reservation system, integrated payment gateway, and a portable mobile POS for instant invoicing on the dock.</span></p> </li> \n</ul>"
      }
    },
